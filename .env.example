# Somente no servidor Node/Netlify. Nunca versionar valores reais.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# O backend Python publicado já é usado por padrão em python-deployment.json.
# Para desenvolvimento local: inicie python_api/run_local.py e use a URL abaixo.
# NEXO_PYTHON_URL=http://127.0.0.1:4180/api/agent
DISABLE_AI=false
# Chaves pessoais de Gemini ou OpenAI podem ser conectadas pelo perfil na UI.
# A aplicação mantém essas chaves somente em memória nesta aba.
